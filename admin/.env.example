# Mot de passe d'accès à l'admin (à changer absolument en prod)
ADMIN_PASSWORD=changeme-une-phrase-longue-et-unique

# Secret pour signer les cookies de session (changer en prod)
SESSION_SECRET=un-autre-secret-tres-long-genere-aleatoirement

# Port d'écoute du serveur Node.js (4001 par défaut, choisir un port libre)
PORT=4001

# Chemin vers le dossier templates-vitrine (parent du dossier admin/ par défaut).
# Optionnel — utile uniquement si vous voulez pointer un autre emplacement.
# TEMPLATES_PATH=/opt/templates-vitrine
